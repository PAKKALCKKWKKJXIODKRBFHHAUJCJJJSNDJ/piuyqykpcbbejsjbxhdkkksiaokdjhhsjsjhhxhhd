local function playPath(model)
	if #path == 0 then
		return
	end

local i = 1


	while model.Parent and not dead do
	if frozen then
		rs.Heartbeat:Wait()
	elseif paused and not far then
			rs.Heartbeat:Wait()
		elseif path[i] then
			local target = path[i].p
			local mcf = model:GetPivot()
			local pos = mcf.Position
			local dis = (target - pos).Magnitude

			if dis < 0.15 then
				i += 1
			else
				local dt = rs.Heartbeat:Wait()

				if (paused and not far) or dead then
					continue
				end

				local step = math.min(speed * dt, dis)
				local p = pos + (target - pos).Unit * step

				local rot = mcf.Rotation
local lookp = target

if far then
	local n = math.min(i + 10, #path)
	lookp = path[n].p
end

local dir = lookp - p

if dir.Magnitude > 0.01 then
	local want = CFrame.lookAt(p, p + dir.Unit)

		rot = mcf:Lerp(
			want,
			math.clamp(rotspd * dt, 0, 1)
		).Rotation
end
				
	

				model:PivotTo(CFrame.new(p) * rot)
			end
		else
			rs.Heartbeat:Wait()
		end
	end
end

