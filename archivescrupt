-- TOGGLE HELPERS
--------------------------------------------------

local function clearESP()
	for i = #ESPs, 1, -1 do
		local esp = ESPs[i]

		if esp.highlight then
			removeTracer(esp.highlight)

			if esp.highlight.Parent then
				esp.highlight:Destroy()
			end
		end

		if esp.billboard
			and esp.billboard.Parent then

			esp.billboard:Destroy()
		end

		table.remove(ESPs, i)
	end

	for highlight, line in pairs(
		Tracers
	) do
		line:Remove()
		Tracers[highlight] = nil
	end
end

local function rebuildESP()
	clearESP()

	for _, room in ipairs(Rooms) do
		if room.Parent then
			for _, obj in ipairs(
				room:GetDescendants()
			) do
				createESP(obj)
			end
		end
	end

	for _, obj in ipairs(
		Workspace:GetDescendants()
	) do
		checkItemESP(obj)
		checkStardust(obj)
		checkEntity(obj)
	end

	if CurrentRooms then
		for _, room in ipairs(
			CurrentRooms:GetChildren()
		) do
			setupNextDoor(room)
		end
	end
end

