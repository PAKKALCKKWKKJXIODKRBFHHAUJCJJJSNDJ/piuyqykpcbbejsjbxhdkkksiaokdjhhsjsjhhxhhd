local promptElapsed = 0

connect(RunService.Heartbeat, function(dt)
	if not State.AutoCollect then
		return
	end

	promptElapsed += dt

	if promptElapsed < 0.1 then
		return
	end

	promptElapsed = 0

	local char = LP.Character
	local root =
		char and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	for prompt in pairs(prompts) do
		if not prompt.Parent then
			prompts[prompt] = nil
			continue
		end

		local part = prompt.Parent

		if not part:IsA("BasePart") then
			part =
				prompt:FindFirstAncestorWhichIsA(
					"BasePart"
				)
		end

		if part
			and (
				part.Position - root.Position
			).Magnitude < 10 then

			pcall(function()
				fireproximityprompt(prompt)
			end)
		end
	end
end)

