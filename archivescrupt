local HEIGHT = 4.5

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function isGround(part)
	if not part:IsA("BasePart") then
		return false
	end

	local name = part.Name:lower()

	return part.Name == "Floor"
		or part.Name == "Carpet"
		or part.Name == "CarpetLight"
		or part.Name == "Puddle"
		or name:find("conveyer", 1, true) ~= nil
end

local function getGroundY(char, root)
	local excludes = {char}

	local origin = root.Position + Vector3.new(0, 5, 0)
	local direction = Vector3.new(0, -20, 0)

	for _ = 1, 5 do
		rayParams.FilterDescendantsInstances = excludes

		local result = Workspace:Raycast(
			origin,
			direction,
			rayParams
		)

		if not result then
			break
		end

		if isGround(result.Instance) then
			return result.Position.Y
		end

		table.insert(excludes, result.Instance)

		local distance =
			(result.Position - origin).Magnitude

		origin =
			result.Position + Vector3.new(0, 0.01, 0)

		direction =
			Vector3.new(0, -(100 - distance), 0)
	end
end

connect(RunService.Heartbeat, function()
	if not State.AntiFly then
		return
	end

	local char = LP.Character

	if not char then
		return
	end

	local root =
		char:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local groundY = getGroundY(char, root)

	if not groundY then
		return
	end

	local targetY = groundY + HEIGHT
	local pos = root.Position

	local rx, ry, rz =
		root.CFrame:ToOrientation()

	root.CFrame =
		CFrame.new(
			pos.X,
			targetY,
			pos.Z
		) *
		CFrame.Angles(rx, ry, rz)
end)

