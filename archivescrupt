--------------------------------------------------
-- TRACERS & ROOM UPDATE LOOP
--------------------------------------------------

local Camera = Workspace.CurrentCamera
local Tracers = {}

local function createTracer(highlight)
	if not State.Tracer then
		return
	end

	if not highlight or not highlight.Parent then
		return
	end

	if Tracers[highlight] then
		return
	end

	local line = Drawing.new("Line")

	line.Thickness = 1.5
	line.Transparency = 1
	line.Visible = false

	Tracers[highlight] = line
end

local function removeTracer(highlight)
	local line = Tracers[highlight]

	if line then
		line:Remove()
		Tracers[highlight] = nil
	end
end

connect(
	RunService.RenderStepped,
	function()
		CurrentRoom = getCurrentRoom()

		-- Update ESP visibility based on room
		for _, esp in ipairs(ESPs) do
			if esp.highlight and esp.highlight.Parent then
				local visible = esp.alwaysVisible or (esp.room and esp.room == CurrentRoom)
				esp.highlight.Enabled = visible
				if esp.billboard and esp.billboard.Parent then
					esp.billboard.Enabled = visible
				end
			end
		end

		if not State.Tracer then
			for _, line in pairs(Tracers) do
				line.Visible = false
			end
			return
		end

		Camera = Workspace.CurrentCamera

		for _, esp in ipairs(ESPs) do
			local highlight = esp.highlight
			local billboard = esp.billboard

			if not highlight
				or not highlight.Parent
				or not billboard
				or not billboard.Parent
				or not billboard.Enabled then

				removeTracer(highlight)
				continue
			end

			createTracer(highlight)

			local line = Tracers[highlight]

			if not line then
				continue
			end

			local target = highlight.Adornee

			if not target or not target.Parent then
				line.Visible = false
				removeTracer(highlight)
				continue
			end

			local position

			if target:IsA("Model") then
				local success, cf = pcall(function()
					return target:GetBoundingBox()
				end)
				if success and cf then
					position = cf.Position
				else
					line.Visible = false
					continue
				end

			elseif target:IsA("BasePart") then
				position = target.Position

			else
				line.Visible = false
				continue
			end

			local screenPos, onScreen =
				Camera:WorldToViewportPoint(
					position
				)

			if not onScreen
				or screenPos.Z <= 0 then

				line.Visible = false
				continue
			end

			local viewport =
				Camera.ViewportSize

			line.From =
				Vector2.new(
					viewport.X / 2,
					viewport.Y
				)

			line.To =
				Vector2.new(
					screenPos.X,
					screenPos.Y
				)

			local label =
				billboard:FindFirstChildWhichIsA(
					"TextLabel"
				)

			if label then
				line.Color =
					label.TextColor3
			end

			line.Visible = true
		end
	end
)

