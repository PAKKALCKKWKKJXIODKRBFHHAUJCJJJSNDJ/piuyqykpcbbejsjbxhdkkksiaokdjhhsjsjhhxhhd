local BashModels = {}
local ScribblesModels = {}

local function isBash(obj)
	return obj:IsA("Model")
		and obj.Name:lower():find(
			"bash",
			1,
			true
		) ~= nil
end

local function isScribbles(obj)
	return obj:IsA("Model")
		and obj.Name:lower():find(
			"scribbles",
			1,
			true
		) ~= nil
end

local function entityESP(
	obj,
	color,
	text,
	enabled
)
	if not enabled then
		return
	end

	if not obj:FindFirstChild(
		"ESPHighlight"
	) then

		addESP(
			obj,
			color,
			text,
			nil,
			true
		)
	end
end

local function captionEntity(obj)
	task.spawn(function()
		pcall(function()
			local MainGame = require(
				LP.PlayerGui.MainUI
					.Initiator
					.Main_Game
			)

			MainGame.caption(
				"An entity has spawned: '"
					.. obj.Name
					.. "'"
			)
		end)
	end)
end

local function checkEntity(obj)
	if isBash(obj)
		and not isInsidePlayer(obj) then

		BashModels[obj] = true

		if State.BashCaption then
			captionEntity(obj)
		end

		entityESP(
			obj,
			Color3.fromRGB(
				255, 0, 0
			),
			"Bash",
			State.BashESP
		)
	end

	if isScribbles(obj)
		and not isInsidePlayer(obj) then

		ScribblesModels[obj] = true

		if State.ScribblesCaption then
			captionEntity(obj)
		end

		entityESP(
			obj,
			Color3.fromRGB(
				255, 255, 255
			),
			"Scribbles",
			State.ScribblesESP
		)
	end
end

for _, obj in ipairs(
	Workspace:GetDescendants()
) do
	checkEntity(obj)
end

