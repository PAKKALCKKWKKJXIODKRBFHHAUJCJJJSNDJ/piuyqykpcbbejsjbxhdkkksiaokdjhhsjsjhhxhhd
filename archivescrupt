local NEXT_DOOR_COLOR = Color3.fromRGB(255, 170, 0)

local NextDoorTargets = {}

local function findPlayerModel(room)
	if not room or not room:IsA("Model") then
		return nil
	end

	local playerName = LP.Name:lower()
	local displayName = LP.DisplayName:lower()

	for _, obj in ipairs(room:GetDescendants()) do
		if obj:IsA("Model") then
			local name = obj.Name:lower()

			if string.find(name, playerName, 1, true)
				or string.find(name, displayName, 1, true) then
				return obj
			end
		end
	end
end

local function setupNextDoor(room)
	if not room:IsA("Model") then
		return
	end

	local playerModel = findPlayerModel(room)

	if not playerModel then
		return
	end

	local vineDoors = {}

	for _, obj in ipairs(playerModel:GetDescendants()) do
		if obj:IsA("Model")
			and obj.Name == "ForgetMeNotVineDoors" then

			local base = obj:FindFirstChild("Base", true)

			if base and base:IsA("BasePart") then
				vineDoors[#vineDoors + 1] = {
					model = obj,
					base = base
				}
			end
		end
	end

	if #vineDoors == 0 then
		return
	end

	local beforeLights

	for _, obj in ipairs(playerModel:GetDescendants()) do
		if obj:IsA("Model")
			and obj.Name == "BeforeLights" then

			beforeLights = obj
			break
		end
	end

	if not beforeLights then
		return
	end

	local roomDoor =
		beforeLights:FindFirstChild("RoomDoor", true)

	if not roomDoor
		or not roomDoor:IsA("BasePart") then
		return
	end

	local closest
	local closestDistance = math.huge

	for _, data in ipairs(vineDoors) do
		local distance =
			(data.base.Position - roomDoor.Position).Magnitude

		if distance < closestDistance then
			closestDistance = distance
			closest = data
		end
	end

	if not closest then
		return
	end

	local oldTarget = NextDoorTargets[room]

	if oldTarget == closest.model then
		return
	end

	if oldTarget then
		for _, esp in ipairs(ESPs) do
			if esp.highlight
				and esp.highlight.Adornee == oldTarget then
				removeESP(esp)
				break
			end
		end
	end

	NextDoorTargets[room] = closest.model

	if not closest.model:FindFirstChild("ESPHighlight") then
		addESP(
			closest.model,
			NEXT_DOOR_COLOR,
			"Next Door",
			nil,
			true
		)
	end
end

local function processNextDoor(room)
	task.spawn(function()
		for _ = 1, 50 do
			if not room.Parent then
				return
			end

			setupNextDoor(room)

			if NextDoorTargets[room] then
				return
			end

			task.wait(0.1)
		end
	end)
end

CurrentRooms.ChildAdded:Connect(function(room)
	if not room:IsA("Model") then
		return
	end

	processNextDoor(room)
end)

for _, room in ipairs(CurrentRooms:GetChildren()) do
	if room:IsA("Model") then
		processNextDoor(room)
	end
end

