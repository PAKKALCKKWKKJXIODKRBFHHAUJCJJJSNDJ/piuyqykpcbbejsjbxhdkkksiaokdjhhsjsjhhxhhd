local pickupModels = {}

local function hasPickupAttribute(model)
	for attributeName in pairs(
		model:GetAttributes()
	) do
		local name = attributeName:lower()

		if name:find("pickup", 1, true)
			or name:find("single", 1, true) then

			return true
		end
	end

	return false
end

local function registerPickup(obj)
	if not obj:IsA("Model") then
		return
	end

	if obj.Name == "GoldPile"
		or hasPickupAttribute(obj) then

		pickupModels[obj] = true
	end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
	registerPickup(obj)
end

connect(
	Workspace.DescendantAdded,
	function(obj)
		task.defer(function()
			registerPickup(obj)
		end)
	end
)

local pickupElapsed = 0

connect(RunService.Heartbeat, function(dt)
	if not State.AutoPickup then
		return
	end

	pickupElapsed += dt

	if pickupElapsed < 0.1 then
		return
	end

	pickupElapsed = 0

	local char = LP.Character
	local root =
		char and char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	for model in pairs(pickupModels) do
		if not model.Parent then
			pickupModels[model] = nil
			continue
		end

		local success, cf = pcall(function()
			return model:GetBoundingBox()
		end)

		if success and cf and (
			cf.Position - root.Position
		).Magnitude <= 15 then

			for _, obj in ipairs(
				model:GetDescendants()
			) do

				if obj:IsA("ProximityPrompt") then
					local vending =
						obj:FindFirstAncestorWhichIsA(
							"Model"
						)

					if vending
						and vending.Name:lower():find(
							"vendingmachine",
							1,
							true
						) then
						continue
					end

					obj.MaxActivationDistance = 20
					obj.HoldDuration = 0

					pcall(function()
						fireproximityprompt(obj)
					end)
				end
			end
		end
	end
end)

