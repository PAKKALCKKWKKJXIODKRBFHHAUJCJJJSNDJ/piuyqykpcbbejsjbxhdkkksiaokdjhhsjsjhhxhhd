		checkAttributeModel(obj)
	end)
end)

task.spawn(function()
	while true do
		local room = getCurrentRoom()

		if room ~= CurrentRoom then
			updateRoomESP(room)
		end

		task.wait(0.5)
	end
end)

local Camera = Workspace.CurrentCamera

local Tracers = {}

local function getLabel(target)
	local billboard = target:FindFirstChild("ESPBillboard")

	if not billboard then
		return nil
	end

	return billboard:FindFirstChildWhichIsA("TextLabel")
end

local function createTracer(esp)
	local highlight = esp.highlight

	if not highlight or not highlight.Parent then
		return
	end

	if Tracers[highlight] then
		return
	end

	local line = Drawing.new("Line")
	line.Thickness = 1.5
	line.Transparency = 1
	line.Visible = false

	Tracers[highlight] = line
end

local function removeTracer(highlight)
	local line = Tracers[highlight]

	if line then
		line:Remove()
		Tracers[highlight] = nil
	end
end

local function removeESP(esp)
if not esp then
return
end

if esp.highlight then
	removeTracer(esp.highlight)

	if esp.highlight.Parent then
		esp.highlight:Destroy()
	end
end

if esp.billboard and esp.billboard.Parent then
	esp.billboard:Destroy()
end

for i = #ESPs, 1, -1 do
	if ESPs[i] == esp then
		table.remove(ESPs, i)
		break
	end
end

end

Workspace.DescendantRemoving:Connect(function(obj)
for i = #ESPs, 1, -1 do
local esp = ESPs[i]

	local highlight = esp.highlight
	local billboard = esp.billboard

	if (highlight and (highlight == obj or highlight:IsDescendantOf(obj)))
		or (billboard and (billboard == obj or billboard:IsDescendantOf(obj)))
		or (highlight and highlight.Adornee == obj)
		or (billboard and billboard.Adornee == obj) then

		removeESP(esp)
	end
end

end)

RunService.RenderStepped:Connect(function()
	Camera = Workspace.CurrentCamera

	for _, esp in ipairs(ESPs) do
		local highlight = esp.highlight
		local billboard = esp.billboard

if not highlight
	or not highlight.Parent
	or not billboard
	or not billboard.Parent then

		removeESP(esp)
		continue
end

		createTracer(esp)

		local line = Tracers[highlight]

		if not line then
			continue
		end

		local target = highlight.Adornee or billboard.Adornee

		if not target then
			line.Visible = false
			continue
		end

		local position

		if target:IsA("Model") then
			local cf = target:GetBoundingBox()
			position = cf.Position

		elseif target:IsA("BasePart") then
			position = target.Position

		else
			line.Visible = false
			continue
		end

		local screenPos, onScreen =
			Camera:WorldToViewportPoint(position)

		local label = getLabel(target)

		if not label
			or not billboard.Enabled
			or not onScreen
			or screenPos.Z <= 0 then

			line.Visible = false
			continue
		end

		local viewport = Camera.ViewportSize

		local from = Vector2.new(
			viewport.X / 2,
			viewport.Y
		)

		local to = Vector2.new(
			screenPos.X,
			screenPos.Y
		)

		line.From = from
		line.To = to
		line.Color = label.TextColor3
		line.Visible = true
	end
end)

