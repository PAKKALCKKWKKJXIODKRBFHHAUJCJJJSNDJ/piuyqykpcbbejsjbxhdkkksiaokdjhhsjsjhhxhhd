local CurrentRooms =
	Workspace:WaitForChild("CurrentRooms", 5)

local ESPs = {}
local Rooms = {}
local CurrentRoom

local function isInsidePlayer(obj)
	local current = obj.Parent

	while current
		and current ~= Workspace do

		if current:IsA("Model")
			and current.Name == LP.Name then

			return true
		end

		current = current.Parent
	end

	return false
end

local function getRoom(obj)
	local current = obj

	while current
		and current ~= CurrentRooms do

		if current.Parent == CurrentRooms then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function insideRoom(room, point)
	local success, cf, size = pcall(function()
		return room:GetBoundingBox()
	end)

	if not success or not cf then return false end

	local relative =
		cf:PointToObjectSpace(point)

	return math.abs(relative.X)
		<= size.X * 0.5

		and math.abs(relative.Y)
		<= size.Y * 0.5

		and math.abs(relative.Z)
		<= size.Z * 0.5
end

local function getCurrentRoom()
	local char = LP.Character

	if not char then
		return nil
	end

	local root =
		char:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return nil
	end

	for _, room in ipairs(Rooms) do
		if room.Parent == CurrentRooms
			and insideRoom(
				room,
				root.Position
			) then

			return room
		end
	end

	return nil
end

local function addESP(
	target,
	color,
	text,
	room,
	alwaysVisible
)
	if not target or not target.Parent then return end
	if isInsidePlayer(target) then
		return
	end

	if target:FindFirstChild(
		"ESPHighlight"
	) then
		return
	end

	local highlight =
		Instance.new("Highlight")

	highlight.Name = "ESPHighlight"
	highlight.Adornee = target
	highlight.FillColor = color
	highlight.FillTransparency = 0.75
	highlight.OutlineColor = color
	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Enabled =
		alwaysVisible
		or (room and room == CurrentRoom)

	highlight.Parent = target

	local billboard =
		Instance.new("BillboardGui")

	billboard.Name = "ESPBillboard"
	billboard.Adornee = target
	billboard.AlwaysOnTop = true
	billboard.Size =
		UDim2.fromOffset(100, 22)

	billboard.StudsOffset =
		Vector3.new(0, 2.5, 0)

	billboard.MaxDistance =
		math.huge

	billboard.Enabled =
		alwaysVisible
		or (room and room == CurrentRoom)

	billboard.Parent = target

	local label =
		Instance.new("TextLabel")

	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 =
		Color3.fromRGB(0, 0, 0)

	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.Oswald
	label.TextScaled = true
	label.Parent = billboard

	ESPs[#ESPs + 1] = {
		target = target,
		room = room,
		alwaysVisible = alwaysVisible,
		highlight = highlight,
		billboard = billboard
	}
end

local function createESP(obj)
	if not obj.Parent then
		return
	end

	local isGold =
		State.GoldESP
		and obj:IsA("Model")
		and obj.Name == "GoldPile"

	local isDoor =
		State.DoorESP
		and obj:IsA("BasePart")
		and obj.Name == "Door"
		and obj.Parent
		and obj.Parent.Name == "Door"

	local isHide =
		State.HidingESP
		and obj:IsA("Model")
		and obj.Name:lower():find(
			"hidingspot",
			1,
			true
		)

	if not isGold
		and not isDoor
		and not isHide then

		return
	end

	local target = obj

	if isDoor then
		target = obj.Parent
	end

	local room = getRoom(obj)

	local color
	local text

	if isGold then
		color = Color3.fromRGB(
			255, 255, 0
		)
		text = "GoldPile"

	elseif isDoor then
		color = Color3.fromRGB(
			0, 255, 0
		)
		text = "Door"

	else
		color = Color3.fromRGB(
			255, 255, 255
		)
		text = obj.Name
	end

	addESP(
		target,
		color,
		text,
		room,
		false
	)
end

local function registerRoom(room)
	if not room:IsA("Model") then
		return
	end

	for _, existing in ipairs(Rooms) do
		if existing == room then
			return
		end
	end

	Rooms[#Rooms + 1] = room

	for _, obj in ipairs(
		room:GetDescendants()
	) do
		createESP(obj)
	end
end

if CurrentRooms then
	for _, room in ipairs(
		CurrentRooms:GetChildren()
	) do
		registerRoom(room)
	end

	for _, obj in ipairs(
		CurrentRooms:GetDescendants()
	) do
		createESP(obj)
	end

	connect(
		CurrentRooms.ChildAdded,
		function(room)
			task.defer(function()
				registerRoom(room)
			end)
		end
	)

	connect(
		CurrentRooms.DescendantAdded,
		function(obj)
			task.defer(function()
				createESP(obj)
			end)
		end
	)
end

connect(
	Workspace.DescendantAdded,
	function(obj)
		task.defer(function()
			createESP(obj)
		end)
	end
)

