local StardustModels = {}

local function isStardust(obj)
	return obj:IsA("Model")
		and obj.Name:lower():find(
			"stardust",
			1,
			true
		) ~= nil
end

local function checkStardust(obj)
	if not isStardust(obj) then
		return
	end

	if isInsidePlayer(obj) then
		return
	end

	StardustModels[obj] = true

	if State.StardustESP
		and not obj:FindFirstChild(
			"ESPHighlight"
		) then

		addESP(
			obj,
			Color3.fromRGB(
				255, 255, 0
			),
			"Stardust",
			nil,
			true
		)
	end
end

for _, obj in ipairs(
	Workspace:GetDescendants()
) do
	checkStardust(obj)
end

connect(
	Workspace.DescendantAdded,
	function(obj)
		task.defer(function()
			checkStardust(obj)

			local model =
				obj:FindFirstAncestorWhichIsA(
					"Model"
				)

			if model and isStardust(model) then
				checkStardust(model)
			end
		end)
	end
)

local stardustElapsed = 0

connect(
	RunService.Heartbeat,
	function(dt)
		if not State.StardustESP then
			return
		end

		stardustElapsed += dt

		if stardustElapsed < 0.1 then
			return
		end

		stardustElapsed = 0

		local char = LP.Character
		local root =
			char and char:FindFirstChild(
				"HumanoidRootPart"
			)

		if not root then
			return
		end

		for model in pairs(
			StardustModels
		) do
			if not model.Parent then
				StardustModels[model] = nil
				continue
			end

			local success, cf = pcall(function()
				return model:GetBoundingBox()
			end)

			if success and cf and (
				cf.Position - root.Position
			).Magnitude <= 20 then

				for _, obj in ipairs(
					model:GetDescendants()
				) do
					if obj:IsA(
						"ProximityPrompt"
					) then

						obj.MaxActivationDistance = 20
						obj.HoldDuration = 0

						pcall(function()
							fireproximityprompt(obj)
						end)
					end
				end
			end
		end
	end
)

