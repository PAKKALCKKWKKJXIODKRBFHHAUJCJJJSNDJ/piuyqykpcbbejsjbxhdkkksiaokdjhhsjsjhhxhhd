local CurrentRooms = Workspace:WaitForChild("CurrentRooms")

local ESPs = {}
local Rooms = {}
local CurrentRoom

local function getHighestRoom()
	local highest = nil
	local highestNumber = -math.huge

	for _, obj in ipairs(CurrentRooms:GetChildren()) do
		if obj:IsA("Model") and tonumber(obj.Name) then
			local number = tonumber(obj.Name)

			if tostring(number) == obj.Name and number > highestNumber then
				highestNumber = number
				highest = obj.Name
			end
		end
	end

	return highest
end

local function getRoom(obj)
	local current = obj

	while current and current ~= CurrentRooms do
		if current.Parent == CurrentRooms then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function isPointInsideRoom(room, point)
	local cf, size = room:GetBoundingBox()
	local relative = cf:PointToObjectSpace(point)

	return math.abs(relative.X) <= size.X * 0.5
		and math.abs(relative.Y) <= size.Y * 0.5
		and math.abs(relative.Z) <= size.Z * 0.5
end

local function getCurrentRoom()
	local character = LP.Character

	if not character then
		return nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if not root then
		return nil
	end

	local position = root.Position

	for _, room in ipairs(Rooms) do
		if room.Parent == CurrentRooms
			and isPointInsideRoom(room, position) then
			return room
		end
	end

	return nil
end

local function isInsideLocalPlayerModel(obj)
	local current = obj.Parent

	while current and current ~= Workspace do
		if current:IsA("Model") and current.Name == LP.Name then
			return true
		end

		current = current.Parent
	end

	return false
end

local function addESP(target, color, text, room, alwaysVisible)
	if isInsideLocalPlayerModel(target) then
		return
	end

	if target:FindFirstChild("ESPHighlight") then
		return
	end

	local highlight = Instance.new("Highlight")

	highlight.Name = "ESPHighlight"
	highlight.Adornee = target
	highlight.FillColor = color
	highlight.FillTransparency = 0.75
	highlight.OutlineColor = color
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = alwaysVisible or room == CurrentRoom
	highlight.Parent = target

	local billboard = Instance.new("BillboardGui")

	billboard.Name = "ESPBillboard"
	billboard.Adornee = target
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.fromOffset(90, 20)
	billboard.StudsOffset = Vector3.new(0, 2.5, 0)
	billboard.MaxDistance = math.huge
	billboard.Enabled = alwaysVisible or room == CurrentRoom
	billboard.Parent = target

	local label = Instance.new("TextLabel")

	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0
	label.Font = Enum.Font.Oswald
	label.TextScaled = true
	label.Parent = billboard

	ESPs[#ESPs + 1] = {
		room = room,
		alwaysVisible = alwaysVisible,
		highlight = highlight,
		billboard = billboard
	}
end

local function createRoomESP(obj)
	local isGold =
		obj:IsA("Model")
		and obj.Name == "GoldPile"

	local isDoor =
		obj:IsA("BasePart")
		and obj.Name == "Door"
		and obj.Parent
		and obj.Parent.Name == "Door"

	local isHidingSpot =
		obj:IsA("Model")
		and string.find(obj.Name:lower(), "hidingspot", 1, true)

	if not isGold and not isDoor and not isHidingSpot then
		return
	end

	local target = obj

	if isDoor then
		target = obj.Parent
	end

	if target:FindFirstChild("ESPHighlight") then
		return
	end

	local room = getRoom(obj)

	if not room then
		return
	end

	local color
	local text

	if isGold then
		color = Color3.fromRGB(255, 255, 0)
		text = obj.Name

	elseif isDoor then
		color = Color3.fromRGB(0, 255, 0)
		text = "Door [" .. (getHighestRoom() or "?") .. "]"

	else
		color = Color3.fromRGB(255, 255, 255)
		text = obj.Name
	end

	addESP(target, color, text, room, false)
end

