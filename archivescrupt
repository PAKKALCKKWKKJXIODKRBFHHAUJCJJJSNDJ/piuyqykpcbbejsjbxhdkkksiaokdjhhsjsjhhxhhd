local function registerRoom(room)
	if not room:IsA("Model") then
		return
	end

	for _, existing in ipairs(Rooms) do
		if existing == room then
			return
		end
	end

	Rooms[#Rooms + 1] = room

	for _, obj in ipairs(room:GetDescendants()) do
		createRoomESP(obj)
	end
end

local function updateRoomESP(room)
	if CurrentRoom == room then
		return
	end

	CurrentRoom = room

	for _, esp in ipairs(ESPs) do
		if not esp.alwaysVisible then
			if esp.highlight.Parent and esp.billboard.Parent then
				local enabled = esp.room == room

				esp.highlight.Enabled = enabled
				esp.billboard.Enabled = enabled
			end
		end
	end
end

for _, room in ipairs(CurrentRooms:GetChildren()) do
	registerRoom(room)
end

for _, obj in ipairs(CurrentRooms:GetDescendants()) do
	createRoomESP(obj)
end

for _, obj in ipairs(Workspace:GetDescendants()) do
	checkAttributeModel(obj)
end

CurrentRooms.ChildAdded:Connect(function(room)
	task.defer(function()
		registerRoom(room)

		local newRoom = getCurrentRoom()

		if newRoom ~= CurrentRoom then
			updateRoomESP(newRoom)
		end
	end)
end)

CurrentRooms.DescendantAdded:Connect(function(obj)
	task.defer(function()
		createRoomESP(obj)
	end)
end)

Workspace.DescendantAdded:Connect(function(obj)
