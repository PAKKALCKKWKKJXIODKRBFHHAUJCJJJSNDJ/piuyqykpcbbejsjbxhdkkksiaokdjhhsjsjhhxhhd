task.spawn(function()
    -- 1. Tạo ScreenGui và ImageLabel
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "JumpscareOverlay"
    screenGui.IgnoreGuiInset = true
    screenGui.DisplayOrder = 999999
    screenGui.Parent = playerGui

    local imageLabel = Instance.new("ImageLabel")
    imageLabel.BackgroundTransparency = 1
    imageLabel.BorderSizePixel = 0
    imageLabel.Position = UDim2.new(0, 0, 0, 0)
    imageLabel.Size = UDim2.new(1, 0, 1, 0)
    imageLabel.ScaleType = Enum.ScaleType.Stretch
    imageLabel.ImageTransparency = 0.25
    imageLabel.Visible = true
    imageLabel.ImageColor3 = Color3.fromRGB(143,199,255)
    imageLabel.Parent = screenGui

    -- Danh sách ảnh jumpscare nhấp nháy
    local jumpscareImages = {
        "rbxassetid://134346506410955",
        "rbxassetid://7578853379",
        "rbxassetid://103846711769666",
        "rbxassetid://78199392475572"
    }

    -- Preload ảnh trước để tránh lỗi không load kịp khi chạy hiệu ứng
    task.spawn(function()
        ContentProvider:PreloadAsync(jumpscareImages)
    end)

    local duration = 2 -- Thời gian hiệu ứng chạy (có thể điều chỉnh tùy ý)
    local start = os.clock()
    local imageIndex = 1

    -- 2. Khởi tạo Tween mờ dần (từ 0.25 về 1)
    local info = TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local tween = TweenService:Create(imageLabel, info, {ImageTransparency = 1})
    
    -- 3. Chạy Tween
    tween:Play()

    -- 4. Vòng lặp đổi ảnh chạy đồng thời với Tween
    while os.clock() - start < duration do
        if not imageLabel or not imageLabel.Parent then break end
        imageLabel.Image = jumpscareImages[imageIndex]
        imageIndex = (imageIndex % #jumpscareImages) + 1
        task.wait(0.04) -- Tốc độ chớp ảnh ổn định hơn
    end

    -- 5. Đợi Tween hoàn thành hẳn rồi dọn dẹp GUI
    if tween.PlaybackState == Enum.PlaybackState.Playing then
        tween.Completed:Wait()
    end
    
    screenGui:Destroy()
end)

	end
end)

