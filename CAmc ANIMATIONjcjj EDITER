		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

RunService.RenderStepped:Connect(function(dt)
	if not freecam or playing then return end

	if mouseLook then
		local mouse = UIS:GetMouseLocation()
		local d = mouse - lastMouse
		lastMouse = mouse

		yaw -= d.X * 0.003
		pitch = math.clamp(pitch - d.Y * 0.003, -1.5, 1.5)
	end

	local rotation = CFrame.fromOrientation(pitch, yaw, 0)
	local move = Vector3.zero

	if keys.W then move += Vector3.new(0, 0, -1) end
	if keys.S then move += Vector3.new(0, 0, 1) end
	if keys.A then move += Vector3.new(-1, 0, 0) end
	if keys.D then move += Vector3.new(1, 0, 0) end
	if keys.Q then move += Vector3.new(0, -1, 0) end
	if keys.E then move += Vector3.new(0, 1, 0) end

	if mobileMove.Magnitude > 0.01 then
		move += Vector3.new(mobileMove.X, 0, mobileMove.Y)
	end

	if move.Magnitude > 1 then
		move = move.Unit
	end

	if move.Magnitude > 0 then
		local speed = 30
		camPos += rotation:VectorToWorldSpace(move) * speed * dt
	end

	camera.CFrame = CFrame.new(camPos) * rotation
end)

