local scrubbing = false

timeline.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		scrubbing = true
		local maxTime = getMaxTime()
		local absPos = keysFrame.AbsolutePosition.X
		local absSize = keysFrame.AbsoluteSize.X
		if absSize > 0 then
			local relativeX = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
			currentTime = relativeX * maxTime
			timeBox.Text = string.format("%.2f", currentTime)
			refresh()
		end
	end
end)

UIS.InputChanged:Connect(function(input)
	if scrubbing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local maxTime = getMaxTime()
		local absPos = keysFrame.AbsolutePosition.X
		local absSize = keysFrame.AbsoluteSize.X
		if absSize > 0 then
			local relativeX = math.clamp((input.Position.X - absPos) / absSize, 0, 1)
			currentTime = relativeX * maxTime
			timeBox.Text = string.format("%.2f", currentTime)
			refresh()
		end
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		scrubbing = false
	end
end)

create.MouseButton1Click:Connect(function()
	local t = tonumber(timeBox.Text) or currentTime
	t = math.max(0, t)
	
	if #keyframes >= maxKeyframesPerLayer then
	local updating = false

	for _, k in ipairs(keyframes) do
		if math.abs(k.Time - t) < 0.001 then
			updating = true
			break
		end
	end

	if not updating then
		notify("This layer already has 10 keyframes.")
		return
	end
end

	for _, k in ipairs(keyframes) do
		if math.abs(k.Time - t) < 0.001 then
			k.CFrame = camera.CFrame
			k.Tween = pendingTweenType
			k.Direction = pendingTweenDirection
			refresh()
			status.Text = "Keyframe updated"
			return
		end
	end

	table.insert(keyframes, {
		Time = t,
		CFrame = camera.CFrame,
		Tween = pendingTweenType,
		Direction = pendingTweenDirection
	})

	sortKeys()
	selectedKey = nil
	currentTime = t
	timeBox.Text = string.format("%.2f", currentTime)

	refresh()
	status.Text = "Keyframe created"
end)

