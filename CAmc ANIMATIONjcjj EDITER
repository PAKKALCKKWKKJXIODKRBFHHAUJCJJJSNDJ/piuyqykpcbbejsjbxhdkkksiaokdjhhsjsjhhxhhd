local function serialize(cf)
	local t = {cf:GetComponents()}
	local s = ""
	for i, v in ipairs(t) do
		s = s .. string.format("%.10f", v)
		if i < #t then s = s .. "," end
	end
	return s
end

local function sanitizeName(name)
	name = name:gsub("[\\/:*?\"<>|]", "_")
	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	return name
end

local function createAnimationData(name)
	local out = "return {\n"
	out = out .. "\tName = " .. string.format("%q", name) .. ",\n"
	out = out .. "\tSpeed = " .. string.format("%.10f", getSpeed()) .. ",\n"
	out = out .. "\tKeyframes = {\n"

	for _, k in ipairs(keyframes) do
		out = out .. "\t\t{\n"
		out = out .. "\t\t\tTime = " .. string.format("%.10f", k.Time) .. ",\n"
		out = out .. "\t\t\tCFrame = CFrame.new(" .. serialize(k.CFrame) .. "),\n"
		out = out .. "\t\t\tTween = " .. string.format("%q", k.Tween or "Linear") .. ",\n"
		out = out .. "\t\t\tDirection = " .. string.format("%q", k.Direction or "InOut") .. ",\n"
		out = out .. "\t\t\tEffect = " .. string.format("%q", k.Effect or "") .. ",\n"
		out = out .. "\t\t},\n"
	end

	out = out .. "\t}\n"
	out = out .. "}"

	return out
end

