local function ease(alpha, style, direction)
	if style == "Cut" then
		return 1
	end

	local easingStyle = Enum.EasingStyle[style] or Enum.EasingStyle.Linear
	local easingDirection = Enum.EasingDirection[direction] or Enum.EasingDirection.InOut

	return TweenService:GetValue(
		alpha,
		easingStyle,
		easingDirection
	)
end

local function finishAnimation()
	playing = false
	activeTween = nil

	currentLayer = math.max(1, math.min(playStartLayer, getLastLayer()))
	keyframes = layers[currentLayer]

	selectedKey = nil

	restoreAllGui()

	updateFreecamState(freecam)

	if freecam then
		camera.CameraType = Enum.CameraType.Scriptable
		joystick.Visible = mobile
	else
		camera.CameraType = Enum.CameraType.Custom
		joystick.Visible = false
	end

	currentTime = currentTime or 0
	timeBox.Text = string.format("%.2f", currentTime)

	refresh()
	updateLayerUI()

	status.Text = "Animation finished"
end

local function runKeyframeEffect(key)
	if not key or not key.Effect or key.Effect == "" then
		return
	end

	local fn = key.CompiledEffect

	if not fn then
		local success, result = pcall(loadstring, key.Effect)

		if not success or type(result) ~= "function" then
			return
		end

		fn = result
		key.CompiledEffect = fn
	end

	task.spawn(function()
		pcall(fn)
	end)
end

local function playAnimation()
	if #keyframes < 2 or playing then
		return
	end

	sortKeys()

	playing = true
	activeTween = nil

	playStartLayer = currentLayer

	currentLayer = 1
	keyframes = layers[1]
	selectedKey = nil
	currentTime = 0

	hideAllGui()

	camera.CameraType = Enum.CameraType.Scriptable

	local firstKey = layers[1][1]

	if not firstKey then
		finishAnimation()
		return
	end

	camera.CFrame = firstKey.CFrame
	camPos = firstKey.CFrame.Position

	local fx, fy = firstKey.CFrame:ToOrientation()
	pitch, yaw = fx, fy

	task.spawn(function()
		runKeyframeEffect(firstKey)
	end)

	currentTime = firstKey.Time

	for layerIndex = 1, getLastLayer() do
		if not playing then
			break
		end

		currentLayer = layerIndex
		keyframes = layers[layerIndex]
		selectedKey = nil

		local layer = layers[layerIndex]

		if #layer == 0 then
			continue
		end

		table.sort(layer, function(a, b)
			return a.Time < b.Time
		end)

		for i = 1, #layer - 1 do
			if not playing then
				break
			end

			local a = layer[i]
			local b = layer[i + 1]

			local rawDuration = math.max(
				b.Time - a.Time,
				0
			)

			local speed = math.max(getSpeed(), 0.01)
			local duration = rawDuration / speed

			if duration <= 0 then
				currentTime = b.Time

				if a.Tween == "Cut" then
					camera.CFrame = b.CFrame
				else
					camera.CFrame = b.CFrame
				end

				camPos = b.CFrame.Position

				local x, y = b.CFrame:ToOrientation()
				pitch, yaw = x, y

				task.spawn(function()
					runKeyframeEffect(b)
				end)

				continue
			end

			local startCFrame = a.CFrame
			local startTime = os.clock()

			while playing do
				local elapsed = os.clock() - startTime
				local alpha = math.clamp(
					elapsed / duration,
					0,
					1
				)

				-- Timeline luôn chạy từ A -> B,
				-- kể cả khi transition là Cut.
				currentTime =
					a.Time +
					(b.Time - a.Time) * alpha

				-- CUT:
				-- Camera giữ nguyên tại A trong toàn bộ duration.
				-- Chỉ snap sang B khi alpha đạt 1.
				if a.Tween == "Cut" then
					camera.CFrame = startCFrame

				-- NORMAL TWEEN
				else
					local easedAlpha = ease(
						alpha,
						a.Tween or "Linear",
						a.Direction or "InOut"
					)

					camera.CFrame =
						startCFrame:Lerp(
							b.CFrame,
							easedAlpha
						)
				end

				if alpha >= 1 then
					break
				end

				RunService.RenderStepped:Wait()
			end

			if not playing then
				break
			end

			-- Đã tới đúng thời điểm của keyframe B.
			currentTime = b.Time

			-- Cut chỉ snap camera tại thời điểm này.
			camera.CFrame = b.CFrame

			camPos = b.CFrame.Position

			local x, y = b.CFrame:ToOrientation()
			pitch, yaw = x, y

			task.spawn(function()
				runKeyframeEffect(b)
			end)
		end
	end

	if not playing then
		return
	end

	local lastLayerIndex = getLastLayer()
	local lastLayer = layers[lastLayerIndex]

	if lastLayer and #lastLayer > 0 then
		table.sort(lastLayer, function(a, b)
			return a.Time < b.Time
		end)

		local lastKey = lastLayer[#lastLayer]

		camera.CFrame = lastKey.CFrame
		currentTime = lastKey.Time

		camPos = lastKey.CFrame.Position

		local x, y = lastKey.CFrame:ToOrientation()
		pitch, yaw = x, y
	end

	finishAnimation()
end

