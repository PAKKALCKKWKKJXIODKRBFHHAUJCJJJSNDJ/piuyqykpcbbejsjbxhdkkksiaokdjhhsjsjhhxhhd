		return
	end

	if confirmAction == "import" then
		if not selectedAnimationFile then
			confirmFrame.Visible = false
			return
		end

		local fileData = selectedAnimationFile

		local success, fileContent = pcall(function()
			return readfile(fileData.File)
		end)

		if not success or not fileContent then
			notify("Failed to read animation file.")
			confirmFrame.Visible = false
			selectedAnimationFile = nil
			confirmAction = nil
			return
		end

		local fn, err = loadstring(fileContent)

		if not fn then
			notify("Invalid animation file.")
			confirmFrame.Visible = false
			selectedAnimationFile = nil
			confirmAction = nil
			return
		end

		local ok, data = pcall(fn)

		if not ok or type(data) ~= "table" then
			notify("Invalid animation data.")
			confirmFrame.Visible = false
			selectedAnimationFile = nil
			confirmAction = nil
			return
		end

		table.clear(keyframes)

		for _, k in ipairs(data.Keyframes or {}) do
			if typeof(k.CFrame) == "CFrame" and tonumber(k.Time) then
				table.insert(keyframes, {
