		end

		sortKeys()

		if tonumber(data.Speed) then
			speedBox.Text = "Speed " .. tostring(data.Speed)
		end

		currentTime = 0
		selectedKey = nil
		pendingTweenType = "Linear"
		pendingTweenDirection = "InOut"

		timeBox.Text = "0"

		refresh()

		confirmFrame.Visible = false
		importFrame.Visible = false
		overlay.Visible = false

		notify("Succesfully loaded animation file: " .. fileData.Name)

		selectedAnimationFile = nil
		confirmAction = nil
	end
end)

