local function hideAllGui()
	if guiHidden then return end
	guiHidden = true

	table.clear(hiddenGuiObjects)
	table.clear(hiddenCoreGuiTypes)

	local function saveAndHide(obj)
		if obj:IsA("ScreenGui") then
			if hiddenGuiObjects[obj] == nil then
				hiddenGuiObjects[obj] = {
					Type = "ScreenGui",
					Enabled = obj.Enabled
				}
			end

			pcall(function()
				obj.Enabled = false
			end)

		elseif obj:IsA("GuiObject") then
			if hiddenGuiObjects[obj] == nil then
				hiddenGuiObjects[obj] = {
					Type = "GuiObject",
					Visible = obj.Visible
				}
			end

			pcall(function()
				obj.Visible = false
			end)
		end
	end

	for _, obj in ipairs(playerGui:GetDescendants()) do
		saveAndHide(obj)
	end

	for _, obj in ipairs(playerGui:GetChildren()) do
		saveAndHide(obj)
	end

	for _, obj in ipairs(game:GetService("CoreGui"):GetDescendants()) do
		saveAndHide(obj)
	end

	for _, type in ipairs(Enum.CoreGuiType:GetEnumItems()) do
		pcall(function()
			hiddenCoreGuiTypes[type] = StarterGui:GetCoreGuiEnabled(type)
			StarterGui:SetCoreGuiEnabled(type, false)
		end)
	end

	table.insert(guiHideConnections,
		playerGui.DescendantAdded:Connect(function(obj)
			if not guiHidden then return end

			if obj:IsA("ScreenGui") then
				hiddenGuiObjects[obj] = {
					Type = "ScreenGui",
					Enabled = obj.Enabled
				}

				pcall(function()
					obj.Enabled = false
				end)

			elseif obj:IsA("GuiObject") then
				hiddenGuiObjects[obj] = {
					Type = "GuiObject",
					Visible = obj.Visible
				}

				pcall(function()
					obj.Visible = false
				end)
			end
		end)
	)

	table.insert(guiHideConnections,
		game:GetService("CoreGui").DescendantAdded:Connect(function(obj)
			if not guiHidden then return end

			if obj:IsA("ScreenGui") then
				hiddenGuiObjects[obj] = {
					Type = "ScreenGui",
					Enabled = obj.Enabled
				}

				pcall(function()
					obj.Enabled = false
				end)

			elseif obj:IsA("GuiObject") then
				hiddenGuiObjects[obj] = {
					Type = "GuiObject",
					Visible = obj.Visible
				}

				pcall(function()
					obj.Visible = false
				end)
			end
		end)
	)
end

local function restoreAllGui()
	if not guiHidden then return end

	guiHidden = false

	for _, connection in ipairs(guiHideConnections) do
		pcall(function()
			connection:Disconnect()
		end)
	end

	table.clear(guiHideConnections)

	for obj, data in pairs(hiddenGuiObjects) do
		if obj and obj.Parent then
			pcall(function()
				if data.Type == "ScreenGui" then
					obj.Enabled = data.Enabled
				elseif data.Type == "GuiObject" then
					obj.Visible = data.Visible
				end
			end)
		end
	end

	for type, enabled in pairs(hiddenCoreGuiTypes) do
		pcall(function()
			StarterGui:SetCoreGuiEnabled(type, enabled)
		end)
	end

	table.clear(hiddenGuiObjects)
	table.clear(hiddenCoreGuiTypes)
end

local function setFreecamCharacterVisibility(enabled)
	local character = player.Character
	if not character then return end

	if enabled then
		table.clear(savedTransparency)

		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("BasePart") then
				if obj.Name == "Head" or obj:FindFirstAncestorOfClass("Accessory") then
					savedTransparency[obj] = obj.Transparency
					obj.Transparency = 0
				end
			end
		end
	else
		for obj, transparency in pairs(savedTransparency) do
			if obj and obj.Parent then
				obj.Transparency = transparency
			end
		end

		table.clear(savedTransparency)
	end
end

-- Hàm quản lý trạng thái Anchor và Camera Type
local function updateFreecamState(isFreecam)
	local character = player.Character or player.CharacterAdded:Wait()
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if rootPart then
		rootPart.Anchored = isFreecam
	end

	if humanoid then
		humanoid.AutoRotate = not isFreecam
	end

	setFreecamCharacterVisibility(isFreecam)

	if isFreecam then
		camera.CameraType = Enum.CameraType.Scriptable
	else
		camera.CameraType = Enum.CameraType.Custom
	end
end

