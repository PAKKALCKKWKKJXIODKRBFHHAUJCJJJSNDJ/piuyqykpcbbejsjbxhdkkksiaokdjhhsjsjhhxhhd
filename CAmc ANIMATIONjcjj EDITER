getLastLayer = function()
	local highest = 0

	for index in pairs(layers) do
		if index > highest then
			highest = index
		end
	end

	return highest
end

local function createLayer(index)
	if not layers[index] then
		layers[index] = {}
	end
end

local function switchLayer(index)
	if index < 1 then
		return
	end

	createLayer(index)

	currentLayer = index
	updateCurrentLayer()
end

