local function getAnimationFiles()
	local files = {}

	if not listfiles then
		return files
	end

	local success, result = pcall(function()
		return listfiles("")
	end)

	if not success or type(result) ~= "table" then
		success, result = pcall(listfiles)
	end

	if not success or type(result) ~= "table" then
		return files
	end

	for _, file in ipairs(result) do
		file = tostring(file)

		local fileName = file:match("([^\\/]+)$")

		if fileName then
			local name = fileName:match("^CameraAnimation_(.+)%.lua$")

			if name then
				local valid = true

				if isfile then
					local ok, result = pcall(isfile, file)
					valid = ok and result == true
				end

				if valid then
					table.insert(files, {
						File = file,
						Name = name
					})
				end
			end
		end
	end

	table.sort(files, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	return files
end

