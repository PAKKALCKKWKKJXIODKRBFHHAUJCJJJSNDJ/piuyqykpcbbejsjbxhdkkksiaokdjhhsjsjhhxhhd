local function resetStick()
	stick.Position = UDim2.new(0.5, -27.5, 0.5, -27.5)
	mobileMove = Vector2.zero
end

local function updateStick(pos)
	local center = joystick.AbsolutePosition + joystick.AbsoluteSize / 2
	local delta = Vector2.new(pos.X, pos.Y) - center
	local radius = joystick.AbsoluteSize.X / 2 - 27.5

	if delta.Magnitude > radius then
		delta = delta.Unit * radius
	end

	stick.Position = UDim2.new(0.5, delta.X - 27.5, 0.5, delta.Y - 27.5)
	mobileMove = Vector2.new(delta.X / radius, delta.Y / radius)
end

joystick.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		touchMove = input
		updateStick(input.Position)
	end
end)

joystick.InputChanged:Connect(function(input)
	if input == touchMove and input.UserInputType == Enum.UserInputType.Touch then
		updateStick(input.Position)
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == touchMove and input.UserInputType == Enum.UserInputType.Touch then
		updateStick(input.Position)
	end

	if input == touchLook and input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - lastLook
		lastLook = input.Position

		yaw -= delta.X * 0.004
		pitch = math.clamp(pitch - delta.Y * 0.004, -1.5, 1.5)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input == touchMove then
		touchMove = nil
		resetStick()
	end

	if input == touchLook then
		touchLook = nil
		lastLook = nil
	end
end)

UIS.TouchStarted:Connect(function(touch)
	if not mobile or not freecam or playing then return end
	local pos = touch.Position

	if pos.X < camera.ViewportSize.X * 0.5 then return end
	if pos.Y > camera.ViewportSize.Y - 190 then return end

	touchLook = touch
	lastLook = pos
end)

