		overlay.Visible = false

		refresh()
		status.Text = "All keyframes deleted"

		return
	end

	-- phần code confirmAction cũ ở dưới
	if confirmAction == "delete" then
		if not selectedDeleteFile then
			confirmFrame.Visible = false
			return
		end

		local fileData = selectedDeleteFile
