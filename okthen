local function GetToggleSpawn()
	local togglePos = HubToggle.AbsolutePosition
	local toggleSize = HubToggle.AbsoluteSize

	return UDim2.fromOffset(
		togglePos.X + toggleSize.X / 2,
		togglePos.Y + toggleSize.Y / 2
	)
end

local function StopHubTween()
	HubTweenId += 1

	if ActiveHubTween then
		ActiveHubTween:Cancel()
		ActiveHubTween = nil
	end

	HubTweening = false
	CanDragHub = false
end

local function OpenHub()
	StopHubTween()

	HubOpened = true
	HubTweening = true

	local id = HubTweenId
	local spawn = GetToggleSpawn()

	Main.Visible = true
	Main.AnchorPoint = Vector2.new(.5, .5)
	Main.Position = spawn
	Main.Size = UDim2.fromOffset(1, 1)

	local tween = Tween(
		Main,
		.3,
		{
			Position = HubCenterPosition,
			Size = HubSize
		},
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.InOut
	)

	ActiveHubTween = tween

	tween.Completed:Once(function()
		if id ~= HubTweenId then
			return
		end

		if ActiveHubTween ~= tween then
			return
		end

		ActiveHubTween = nil

		if not HubOpened then
			return
		end

		Main.Visible = true
		Main.Position = HubCenterPosition
		Main.Size = HubSize

		HubTweening = false
		CanDragHub = true
	end)
end

local function CloseHub()
	StopHubTween()

	HubOpened = false
	HubTweening = true

	local id = HubTweenId
	local spawn = GetToggleSpawn()

	Main.Visible = true

	local tween = Tween(
		Main,
		.3,
		{
			Position = spawn,
			Size = UDim2.fromOffset(1, 1)
		},
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.InOut
	)

	ActiveHubTween = tween

	tween.Completed:Once(function()
		if id ~= HubTweenId then
			return
		end

		if ActiveHubTween ~= tween then
			return
		end

		ActiveHubTween = nil

		if HubOpened then
			return
		end

		Main.Visible = false
		Main.Position = spawn
		Main.Size = UDim2.fromOffset(1, 1)

		HubTweening = false
		CanDragHub = false
	end)
end

local function ToggleHub()
	if HubTweening then
		return
	end

	if HubOpened then
		CloseHub()
	else
		OpenHub()
	end
end


local ToggleDragging = false
local ToggleDragStart
local ToggleStartPosition
local ToggleMoved = false

HubToggle.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	ToggleDragging = true
	ToggleMoved = false

	ToggleDragStart = input.Position
	ToggleStartPosition = HubToggle.Position
end)

UserInputService.InputChanged:Connect(function(input)
	if not ToggleDragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - ToggleDragStart

	if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
		ToggleMoved = true
	end

	HubToggle.Position = UDim2.new(
		ToggleStartPosition.X.Scale,
		ToggleStartPosition.X.Offset + delta.X,

		ToggleStartPosition.Y.Scale,
		ToggleStartPosition.Y.Offset + delta.Y
	)
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if not ToggleDragging then
		return
	end

	ToggleDragging = false

	if ToggleMoved then
		return
	end

	ToggleHub()
end)

