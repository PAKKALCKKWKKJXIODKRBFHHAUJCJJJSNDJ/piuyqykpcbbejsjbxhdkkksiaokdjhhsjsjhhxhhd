local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Functions.lua"
))()

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

local REPENTANCE_URL =
	"https://github.com/RegularVynixu/DOORS-Entity-Spawner/raw/6a9aa84681668d9bbd5c178557f48ad67aa42461/Assets/Repentance.rbxm?raw=true"

local RepentanceAsset = LoadCustomInstance(REPENTANCE_URL)

if not RepentanceAsset then
	return
end

local Main_Game

pcall(function()
	Main_Game = require(
		player.PlayerGui.MainUI.Initiator.Main_Game
	)
end)

local function GetPivot(target)
	if target:IsA("Model") then
		return target:GetPivot()
	elseif target:IsA("BasePart") then
		return target.CFrame
	end
end

local function SetPivot(target, cf)
	if target:IsA("Model") then
		target:PivotTo(cf)
	elseif target:IsA("BasePart") then
		target.CFrame = cf
	end
end

local function IsAlive(target)
	return target and target.Parent
end

local function CrucifixEntity(config)
	local Target = config.Target
	local RESIST = config.Resist == true -- Đảo logic: để true thì bật resist
	local maxDistance = config.RequiredDistance or 30
	local effectColor = config.Color or "Default"
	local assetId = config.Symbol or "Moon"
	
	if not IsAlive(Target) then
		return
	end

	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local targetPart
	if Target:IsA("Model") then
		targetPart = Target.PrimaryPart or Target:FindFirstChildWhichIsA("BasePart")
	elseif Target:IsA("BasePart") then
		targetPart = Target
	end

	if not targetPart then
		return
	end

	local tool
	repeat
		tool = character:FindFirstChildOfClass("Tool")
		local hasCrucifix = tool and tool.Name == "Crucifix"
		local inRange = false

		if IsAlive(Target) and hrp and targetPart then
			local distance = (hrp.Position - targetPart.Position).Magnitude
			inRange = distance <= maxDistance
		end

		if not hasCrucifix or not inRange then
			task.wait(0.1)
		end
	until tool and tool.Name == "Crucifix" and IsAlive(Target) and (hrp.Position - targetPart.Position).Magnitude <= maxDistance
	
	local selectedCrucifix = tool

	task.spawn(function()
		task.wait(0.2)

		if selectedCrucifix and selectedCrucifix.Parent then
			selectedCrucifix:Destroy()
		end
	end)

	local targetPivot = GetPivot(Target)

	if not targetPivot then
		return
	end

	local repentance = RepentanceAsset:Clone()

	if assetId ~= "Moon" then
		local pentagramForTexture = repentance:FindFirstChild("Pentagram")

		if pentagramForTexture then
			local beamFlats = {}

			for _, child in ipairs(pentagramForTexture:GetChildren()) do
				if child.Name == "BeamFlat" and child:IsA("Beam") then
					table.insert(beamFlats, child)
				end
			end

			if #beamFlats >= 4 then
				local lastBeamFlat = beamFlats[4]
				local textureId = tostring(assetId)

				if not textureId:match("^rbxassetid://") then
					textureId = "rbxassetid://" .. textureId
				end

				lastBeamFlat.Texture = textureId
			end
		end
	end
	
	local function RecolorPreserveHSV(originalColor, requestedColor)
	local _, originalS, originalV = Color3.toHSV(originalColor)
	local requestedH = select(1, Color3.toHSV(requestedColor))

	return Color3.fromHSV(
		requestedH,
		originalS,
		originalV
	)
end

local function RecolorSequence(sequence, requestedColor)
	local keypoints = {}

	for _, keypoint in ipairs(sequence.Keypoints) do
		table.insert(
			keypoints,
			ColorSequenceKeypoint.new(
				keypoint.Time,
				RecolorPreserveHSV(
					keypoint.Value,
					requestedColor
				)
			)
		)
	end

	return ColorSequence.new(keypoints)
end

local function ApplyEffectColor(root, requestedColor)
	if typeof(requestedColor) ~= "Color3" then
		return
	end

	for _, d in ipairs(root:GetDescendants()) do

		-- Beam
		if d:IsA("Beam") then
			d.Color = RecolorSequence(
				d.Color,
				requestedColor
			)

		-- ParticleEmitter
		elseif d:IsA("ParticleEmitter") then
			d.Color = RecolorSequence(
				d.Color,
				requestedColor
			)

		-- Trail
		elseif d:IsA("Trail") then
			d.Color = RecolorSequence(
				d.Color,
				requestedColor
			)

		-- PointLight / SpotLight / SurfaceLight
		elseif d:IsA("PointLight")
			or d:IsA("SpotLight")
			or d:IsA("SurfaceLight")
		then
			d.Color = RecolorPreserveHSV(
				d.Color,
				requestedColor
			)

		-- BasePart có Material Neon
		elseif d:IsA("BasePart")
			and d.Material == Enum.Material.Neon
		then
			d.Color = RecolorPreserveHSV(
				d.Color,
				requestedColor
			)
		end
	end
end

if not RESIST
	and effectColor ~= "Default"
	and typeof(effectColor) == "Color3"
then
	ApplyEffectColor(
		repentance,
		effectColor
	)
end

	local crucifix = repentance:FindFirstChild("Crucifix")
	local pentagram = repentance:FindFirstChild("Pentagram")
	local entityPart = repentance:FindFirstChild("Entity")

	if not crucifix or not pentagram or not entityPart then
		repentance:Destroy()
		return
	end

	local sound = RESIST
		and crucifix:FindFirstChild("SoundFail")
		or crucifix:FindFirstChild("Sound")

	if not sound then
		repentance:Destroy()
		return
	end

	local circle = pentagram:FindFirstChild("Circle")
	local base = pentagram:FindFirstChild("Base")
	local lightAttach = base and base:FindFirstChild("LightAttach")
	local lightBright = lightAttach and lightAttach:FindFirstChild("LightBright")

	local bodyPosition = crucifix:FindFirstChild("BodyPosition")
	local bodyAngularVelocity = crucifix:FindFirstChild("BodyAngularVelocity")
	local crucifixLight = crucifix:FindFirstChild("Light")
	local explodeParticle = crucifix:FindFirstChild("ExplodeParticle")

	local toolPivot = tool:GetPivot()

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {
		character,
		Target,
		repentance
	}

	local result = workspace:Raycast(
		targetPivot.Position,
		Vector3.new(0, -1000, 0),
		params
	)

	if not result then
		repentance:Destroy()
		return
	end

	repentance:PivotTo(CFrame.new(result.Position))

	crucifix.CFrame = toolPivot
	entityPart.CFrame = targetPivot

	if bodyPosition then
		bodyPosition.Position = (
			hrp.CFrame * CFrame.new(0.5, 3, -6)
		).Position
	end

	repentance.Parent = workspace

	local shaker

	pcall(function()
		if Main_Game and Main_Game.camShaker then
			shaker = Main_Game.camShaker:StartShake(
				5,
				20,
				2,
				Vector3.new()
			)
		end
	end)

	local function waitUntil(t)
		repeat
			RunService.RenderStepped:Wait()
		until not sound.Parent or sound.TimePosition >= t
	end

	local function fadeOut()
		for _, v in ipairs(pentagram:GetChildren()) do
			if v.Name == "BeamFlat" then
				task.delay(v:GetAttribute("Delay") or 0, function()
					if not v.Parent then
						return
					end

					TweenService:Create(
						v,
						TweenInfo.new(
							1.5,
							Enum.EasingStyle.Sine,
							Enum.EasingDirection.In
						),
						{
							Brightness = 0
						}
					):Play()
				end)
			end
		end
	end

	sound:Play()

	local followConnection = RunService.RenderStepped:Connect(function()
		if not repentance.Parent then
			return
		end

		if not IsAlive(Target) then
			return
		end

		SetPivot(Target, entityPart.CFrame)
	end)

	if circle then
		TweenService:Create(
			circle,
			TweenInfo.new(
				2,
				Enum.EasingStyle.Exponential,
				Enum.EasingDirection.Out
			),
			{
				CFrame = circle.CFrame - Vector3.new(0, 25, 0)
			}
		):Play()

		task.delay(2, function()
			if circle.Parent then
				circle:Destroy()
			end
		end)
	end

	if bodyAngularVelocity then
		TweenService:Create(
			bodyAngularVelocity,
			TweenInfo.new(
				4,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.In
			),
			{
				AngularVelocity = Vector3.new(0, 40, 0)
			}
		):Play()
	end

	task.spawn(function()
		waitUntil(2.625)

		if lightBright then
			TweenService:Create(
				lightBright,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Circular,
					Enum.EasingDirection.InOut
				),
				{
					Brightness = 5,
					Range = 40
				}
			):Play()
		end

		if crucifixLight then
			TweenService:Create(
				crucifixLight,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Circular,
					Enum.EasingDirection.InOut
				),
				{
					Brightness = 11.25,
					Range = 30
				}
			):Play()
		end

		task.wait(1.5)

		if lightBright then
			TweenService:Create(
				lightBright,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Circular,
					Enum.EasingDirection.InOut
				),
				{
					Brightness = 0,
					Range = 0
				}
			):Play()
		end

		if crucifixLight then
			TweenService:Create(
				crucifixLight,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Circular,
					Enum.EasingDirection.InOut
				),
				{
					Brightness = 0,
					Range = 0
				}
			):Play()
		end

		if not RESIST then
			if crucifixLight then
				TweenService:Create(
					crucifixLight,
					TweenInfo.new(
						1,
						Enum.EasingStyle.Circular,
						Enum.EasingDirection.InOut
					),
					{
						Brightness = 15,
						Range = 40
					}
				):Play()
			end

			if shaker then
				pcall(function()
					shaker:StartFadeOut(3)
				end)
			end

			fadeOut()

			if bodyAngularVelocity then
				TweenService:Create(
					bodyAngularVelocity,
					TweenInfo.new(
						3,
						Enum.EasingStyle.Sine,
						Enum.EasingDirection.Out
					),
					{
						AngularVelocity = Vector3.new()
					}
				):Play()
			end
		end
	end)

	if not RESIST then
		waitUntil(2)

		TweenService:Create(
			entityPart,
			TweenInfo.new(
				3,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.In
			),
			{
				CFrame = entityPart.CFrame - Vector3.new(0, 25, 0)
			}
		):Play()

		if Target:IsA("Model") then
			for _, v in ipairs(Target:GetDescendants()) do
				if v:IsA("Sound") and not v:GetAttribute("VolumeIgnore") then
					TweenService:Create(
						v,
						TweenInfo.new(
							3,
							Enum.EasingStyle.Back,
							Enum.EasingDirection.In
						),
						{
							Volume = 0
						}
					):Play()
				end
			end
		end

		waitUntil(6.75)
	else
		waitUntil(4)

		if bodyAngularVelocity then
			TweenService:Create(
				bodyAngularVelocity,
				TweenInfo.new(
					3,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.Out
				),
				{
					AngularVelocity = Vector3.new()
				}
			):Play()
		end

		if lightBright then
			TweenService:Create(
				lightBright,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Circular,
					Enum.EasingDirection.InOut
				),
				{
					Brightness = 0,
					Range = 0,
					Color = Color3.fromRGB(255, 116, 130)
				}
			):Play()
		end

		if crucifixLight then
			TweenService:Create(
				crucifixLight,
				TweenInfo.new(
					1.5,
					Enum.EasingStyle.Circular,
					Enum.EasingDirection.InOut
				),
				{
					Brightness = 0,
					Range = 0,
					Color = Color3.fromRGB(255, 116, 130)
				}
			):Play()
		end

		if shaker then
			pcall(function()
				shaker:StartFadeOut(3)
			end)
		end

		task.spawn(function()
			local color = Instance.new("Color3Value")
			color.Value = Color3.fromRGB(137, 207, 255)

			local tween = TweenService:Create(
				color,
				TweenInfo.new(
					0.5,
					Enum.EasingStyle.Sine
				),
				{
					Value = Color3.fromRGB(255, 116, 130)
				}
			)

			tween:Play()

			while tween.PlaybackState == Enum.PlaybackState.Playing do
				for _, d in ipairs(repentance:GetDescendants()) do
					if d:IsA("Beam") then
						d.Color = ColorSequence.new({
							ColorSequenceKeypoint.new(0, color.Value),
							ColorSequenceKeypoint.new(1, color.Value)
						})
					elseif d.Name == "Crucifix"
						and d:IsA("BasePart")
					then
						d.Color = color.Value
					end
				end

				RunService.RenderStepped:Wait()
			end

			color:Destroy()
		end)

		waitUntil(9.625)
	end

	if followConnection then
		followConnection:Disconnect()
	end

	local tween = TweenService:Create(
		repentance.Crucifix,
		TweenInfo.new(1),
		{
			Size = repentance.Crucifix.Size * 3,
			Transparency = 1
		}
	)

	task.spawn(function()
		tween:Play()
		tween.Completed:Wait()

		if not RESIST then
			if Target and Target.Parent then
				Target:Destroy()
			end
		end
	end)

	if lightBright then
		TweenService:Create(
			lightBright,
			TweenInfo.new(1),
			{
				Brightness = 0,
				Range = 0
			}
		):Play()
	end

	if crucifixLight then
		TweenService:Create(
			crucifixLight,
			TweenInfo.new(1),
			{
				Brightness = 0,
				Range = 0
			}
		):Play()
	end

	if not RESIST then
		if explodeParticle then
			explodeParticle:Emit(math.random(20, 30))
		end

		pcall(function()
			if Main_Game and Main_Game.camShaker then
				Main_Game.camShaker:ShakeOnce(
					7.5,
					7.5,
					0.25,
					1.5
				)
			end
		end)
	else
		if Target and Target.Parent then
			Target:SetAttribute("BeingBanished", false)
			Target:SetAttribute("Paused", false)
		end

		fadeOut()
	end

	task.delay(5, function()
		if repentance.Parent then
			repentance:Destroy()
		end
	end)
end

return CrucifixEntity
